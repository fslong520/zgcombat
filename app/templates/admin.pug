extends /templates/base

block content

  .form-horizontal
    form#espionage-form.form-group
      if !me.isAdmin()
        .col-sm-2
        .col-sm-4
        .col-sm-1
      else
        label.control-label.col-sm-2(for="espionage-name-or-email") 身份切换
        .col-sm-4
          input.form-control#espionage-name-or-email(placeholder="邮箱、用户名或 ID", type="text")
        .col-sm-1
          button.btn.btn-primary.btn-large#enter-espionage-mode 007
      label.control-label.col-sm-5(for="espionage-name-or-email")
        em 你当前是 #{me.get('name') || '(无用户名)'}，邮箱 #{me.get('email') || '(无邮箱)'}
        if view.amActually
          br
          em 但实际以 #{view.amActually.get('name') || '(无用户名)'} 身份，邮箱 #{view.amActually.get('email') || '(无邮箱)'}
          br
          button#stop-spying-btn.btn.btn-xs 停止切换
        if view.featureMode
          br
          em 当前处于功能模式 "#{view.featureMode}"
          =" "
          button#clear-feature-mode-btn.btn.btn-sm 清除功能模式
  if me.isAdmin() || me.isOnlineTeacher()
    .form-horizontal
      form#user-search-form.form-group
        label.control-label.col-sm-2(for="user-search") 用户搜索
        .col-sm-4
          input.form-control#user-search(placeholder="邮箱、用户名、姓名等", type="text")
          a.search-help-toggle(href="#") (搜索帮助)
          .search-help
            h4 搜索语法
            ul
              li 用 <code>role:teacher</code> 可按角色限定搜索
              li 默认部分匹配。
              li <code>*</code> 为通配符（例：'<code>rob*@gmail.com</code>'）
              li 避免特殊字符与标点，建议搜索时用 <code>*</code> 代替。
              li
                a(href='http://sphinxsearch.com/docs/latest/extended-syntax.html') 完整语法指南
        .col-sm-1
          button.btn.btn-primary.btn-large#user-search-button 搜索
    #user-search-result

  if me.isOnlineTeacher() && !me.isAdmin()
    div.text-center 使用上方搜索框查找并管理学生账号。
  else if me.isParentAdmin() && !me.isAdmin()
    p 设置管理员当前在线 / 离线状态：
    div.btn-group.btn-group-toggle#toggle-admin-availability(data-toggle="buttons")
      label.btn.btn-secondary(data-value="on" class=`${parentAdminUpdateInProgress ? 'disabled' : ''} ${parentAdminAvailabilityStatus == 'on' ? 'active' : ''}`)
        input(type="radio" name="options" autocomplete="off" :)
        | 在线
      label.btn.btn-secondary(data-value="off" class=`${parentAdminUpdateInProgress ? 'disabled' : ''} ${parentAdminAvailabilityStatus == 'off' ? 'active' : ''}`)
        input(type="radio" name="options" autocomplete="off")
        | 离线
      label.btn.btn-secondary(data-value="by-schedule" class=`${parentAdminUpdateInProgress ? 'disabled' : ''} ${parentAdminAvailabilityStatus == 'by-schedule' ? 'active' : ''}`)
        input(type="radio" name="options" autocomplete="off")
        | 按计划
  else if !me.isAdmin()
    div.text-center 需以管理员身份登录才能查看此页。
  else
    h4 实体
    ul
      li
        a(href="/admin/trial-requests") 试用申请
      li
        a(href="/admin/user-code-problems") 用户代码问题
      li
        a.edit-mandate(href="#mandate") 编辑授权

    h4 数据分析
    ul
      li
        a(href="/admin/classrooms-progress?startDay=2019-08-01&endDay=2019-12-31") 课堂进度 vs 可用内容
      li
        a(href="/admin/classroom-levels") 课堂关卡
      li
        a(href="/admin/analytics") 仪表盘
      li
        a(href="/admin/level-hints") 关卡提示
      li
        a(href="/admin/school-licenses") 学校有效许可
      li
        a(href="/admin/school-counts?batchsize=20000") 学校统计
      li
        a(href="/admin/demo-requests") 教师演示申请
      li
        a(href="/admin/low-usage-users") 低活跃用户
      li
        a(href="/admin/activation-code-usage") 激活码使用
    p
      button.classroom-progress-csv.btn.btn-sm.btn-success 课堂进度 CSV
      input.classroom-progress-class-code(type=text placeholder="<班级代码>")

    h4 其他
    ul
      li
        a(href="/admin/base") Base（调试 base.pug）
      li
        a(href="/admin/clas") CLAs
      li
        a(href="/admin/pending-patches") 补丁
      li
        a(href="/admin/partial-unit-release") 分部发布
      li
        a(href="javascript:void(0)" id="maintenance-mode") 维护模式
      li
        a(href="javascript:void(0)" id="teacher-license-code") 教师许可码


    hr
    h3 本页 URL 查询参数
    p 可为本页创建特殊 URL 以自动执行操作。
    p
      strong 一般格式：
      - var s = "/admin?parameter1=value1" + "&" + "parameter2=value2" + "&" + "parameter3=value3"
      span.spl= s
    p
      strong search：
      span.spl 自动搜索给定用户
      div
        a(href="/admin?search=matt") /admin?search=matt
    p
      strong spy：
      span.spl 自动以给定用户身份查看
      div
        a(href="/admin?spy=matt@example.com") /admin?spy=matt@example.com
    p
      strong user：
      span.spl 自动打开指定用户 ID 的用户对话框
      div
        a(href="/admin?user=1234567890") /admin?user=1234567890

    hr

    h3 成就
    p 临时成就测试用，应由演示系统替换。

    input#increment-field(type="text")
    a.btn.btn-secondary#increment-button(href="#") 增加
